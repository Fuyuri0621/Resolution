  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u5728\u53F0\u5317\u57CE\u5E02\u7684\u55A7\u56C2\u4E4B\u4E0A\uFF0C\u85CF\u8457\u4E00\u689D\u53EA\u6709\u5C11\u6578\u4EBA\u77E5\u66C9\u7684\u8857\u9053\u2014\u2014\u300C\u5929\u4E0A\u8857\u300D\u3002\u9019\u4E0D\u662F\u4E00\u822C\u7684\u8857\u9053\uFF0C\u5B83\u4F4D\u65BC\u8C61\u5C71\u8207\u4FE1\u7FA9\u8A08\u756B\u5340\u4E4B\u9593\uFF0C\u4EFF\u4F5B\u6F02\u6D6E\u5728\u96F2\u7AEF\uFF0C\u5B9B\u5982\u90FD\u5E02\u50B3\u8AAA\u4E2D\u7684\u5922\u5883\u5730\u9EDE\u3002\n\n\u4F46\u9019\u5922\u5883\uFF0C\u4E0D\u662F\u67D4\u7F8E\u6D6A\u6F2B\uFF0C\u800C\u662F\u51B7\u51BD\u4E14\u8FF7\u4EBA\u2014\u2014\u8CFD\u535A\u53F0\u5317\u7684\u795E\u7D93\u4E2D\u6A1E\u3002\u7576\u4F60\u8D8A\u904E\u8C61\u5C71\u611F\u61C9\u9580\uFF0C\u4E00\u9053\u91CF\u5B50\u88C2\u7E2B\u5C07\u4F60\u50B3\u9001\u81F3\u4E00\u500B\u5E73\u884C\u5C64\u7D1A\u7684\u90FD\u5E02\u8EF8\u5FC3\u3002\u5728\u9019\u88E1\uFF0C\u5EFA\u7BC9\u7531\u5149\u675F\u69CB\u6210\uFF0C\u8857\u9053\u92EA\u8A2D\u7684\u662F\u8A18\u61B6\u6676\u9AD4\uFF0C\u6BCF\u4E00\u6B65\u90FD\u6703\u8A18\u9304\u4E0B\u4F60\u7684\u60C5\u7DD2\u6CE2\u52D5\u3002\n\n\u8857\u9053\u5169\u5074\u7684\u9713\u8679\u8A0A\u865F\u4E0D\u53EA\u662F\u88DD\u98FE\uFF0C\u800C\u662F\u8A9E\u610F\u9A45\u52D5\u7684\u8CC7\u8A0A\u6D41\uFF0C\u8207\u4F60\u7684\u8166\u6CE2\u5171\u632F\u3002\u8CA9\u552E\u7684\u4E0D\u518D\u662F\u5496\u5561\u8207\u8336\uFF0C\u800C\u662F\u5408\u6210\u60C5\u7DD2\u6CE8\u5C04\u5291\u8207\u8A18\u61B6\u91CD\u69CB\u5361\u2014\u2014\u8B93\u4F60\u9AD4\u9A57\u5F9E\u672A\u5B58\u5728\u904E\u7684\u904E\u53BB\u6216\u9810\u898B\u4E00\u6BB5\u4E0D\u5B58\u5728\u7684\u672A\u4F86\u3002\n\n\u6700\u50B3\u5947\u7684\uFF0C\u662F\u90A3\u9593\u53EB\u300C\u96F6\u754C\u66F8\u5EAB\u300D\u7684\u8CC7\u6599\u5854\u3002\u5B83\u6703\u6839\u64DA\u4F60\u9032\u5165\u6642\u7684\u7CBE\u795E\u72C0\u614B\u751F\u6210\u4E00\u672C\u66F8\uFF0C\u66F8\u4E2D\u8A18\u8F09\u7684\u4E16\u754C\u53EF\u80FD\u8207\u73FE\u5BE6\u4EA4\u932F\u3002\u4E00\u65E6\u95B1\u8B80\uFF0C\u4F60\u7684\u610F\u8B58\u53EF\u80FD\u77ED\u66AB\u812B\u96E2\u76EE\u524D\u7DAD\u5EA6\uFF0C\u9032\u5165\u300C\u6A21\u64EC\u57DF\u300D\uFF0C\u6210\u70BA\u8857\u9053\u7684\u4E00\u90E8\u5206\u3002\n\n\u6C92\u6709\u4EBA\u77E5\u9053\u5929\u4E0A\u8857\u7684\u771F\u6B63\u4F86\u6E90\u3002\u6709\u4E9B\u4EBA\u8A8D\u70BA\u5B83\u662F\u88AB\u907A\u5FD8\u7684\u5BE6\u9A57\u90FD\u5E02\uFF0C\u6709\u4E9B\u4EBA\u8AAA\u5B83\u662FAI\u96C6\u9AD4\u610F\u8B58\u5728\u96F2\u7AEF\u4E2D\u81EA\u6211\u7DE8\u7E54\u7684\u5E7B\u60F3\u7A7A\u9593\u3002\u4F46\u7121\u8AD6\u771F\u76F8\u70BA\u4F55\uFF0C\u4E00\u65E6\u4F60\u96E2\u958B\uFF0C\u90A3\u6BB5\u7D93\u6B77\u53EA\u6703\u7559\u5728\u8166\u5167\u67D0\u584A\u975E\u516C\u958B\u5340\u57DF\uFF0C\u4E00\u5982\u5F9E\u672A\u5B58\u5728\u3002"
